<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!-- Explicit transitive pins keep the benchmark and test dependency graphs reproducible. -->
  <ItemGroup>
    <PackageVersion Include="Azure.Core" Version="1.65.0" />
    <PackageVersion Include="Humanizer.Core" Version="3.0.10" />
    <PackageVersion Include="Iced" Version="1.22.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="3.2.0" />
    <PackageVersion Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.750501" />
    <PackageVersion Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
    <PackageVersion Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Configuration" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.92.0" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.92.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Abstractions" Version="8.23.0" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageVersion Include="Microsoft.Security.AntiSSRF" Version="1.0.1" />
    <PackageVersion Include="OpenTelemetry" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Api.ProviderBuilderExtensions" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.Abstractions" Version="1.2.0" />
    <PackageVersion Include="OpenTelemetry.PersistentStorage.FileSystem" Version="1.2.0" />
    <PackageVersion Include="Perfolizer" Version="0.7.5" />
    <PackageVersion Include="Pragmastat" Version="14.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <PackageVersion Include="System.Composition" Version="11.0.0" />
    <PackageVersion Include="System.CodeDom" Version="11.0.0" />
    <PackageVersion Include="System.ClientModel" Version="1.17.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="11.0.0" />
    <PackageVersion Include="System.Management" Version="11.0.0" />
    <PackageVersion Include="System.Memory.Data" Version="11.0.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0" />
    <PackageVersion Include="System.Threading.Channels" Version="11.0.0" />
  </ItemGroup>
</Project>
