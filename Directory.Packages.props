<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.12.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="coverlet.MTP" Version="10.1.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!-- Humanizer follows the Roslyn host. The MTP telemetry extension calls a 2.x Application Insights API. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.NETCore.Platforms" Version="7.0.4" />
    <PackageVersion Include="Microsoft.Testing.Extensions.Telemetry" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" Version="2.5.3" />
    <PackageVersion Include="Microsoft.Testing.Platform.MSBuild" Version="2.5.3" />
    <PackageVersion Include="System.Composition" Version="11.0.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="11.0.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="11.0.0" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="11.0.0" />
    <PackageVersion Include="System.Threading.Channels" Version="11.0.0" />
  </ItemGroup>
</Project>
