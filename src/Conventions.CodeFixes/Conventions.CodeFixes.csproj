<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Workspace code fixes for the Cntryl.Conventions.Analyzers diagnostics.</Description>
    <PackageId>Cntryl.Conventions.CodeFixes</PackageId>
    <AssemblyName>Cntryl.Conventions.CodeFixes</AssemblyName>
    <RootNamespace>Cntryl.Conventions.CodeFixes</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the minimum supported Roslyn so the code fixes cannot use a newer API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="5.0.0" PrivateAssets="all"/>
    <ProjectReference Include="../Conventions.Analyzers/Conventions.Analyzers.csproj"/>
  </ItemGroup>

</Project>
