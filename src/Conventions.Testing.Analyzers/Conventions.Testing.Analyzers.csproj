<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Roslyn analyzers enforcing Should/Given/When test naming and ordered Arrange/Act/Assert structure. Detects xUnit, NUnit and MSTest; inert when no test framework is referenced.</Description>
    <PackageId>Cntryl.Conventions.Testing.Analyzers</PackageId>
    <AssemblyName>Cntryl.Conventions.Testing.Analyzers</AssemblyName>
    <RootNamespace>Cntryl.Conventions.Testing.Analyzers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the minimum supported Roslyn so the analyzer cannot use a newer API. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="5.0.0" PrivateAssets="all"/>
  </ItemGroup>

</Project>
