<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>General C# Roslyn conventions for declarations and formatting.</Description>
    <PackageId>Cntryl.Conventions.Analyzers</PackageId>
    <AssemblyName>Cntryl.Conventions.Analyzers</AssemblyName>
    <RootNamespace>Cntryl.Conventions.Analyzers</RootNamespace>
    <PackageTags>$(PackageTags) declarations control-flow formatting</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

</Project>
